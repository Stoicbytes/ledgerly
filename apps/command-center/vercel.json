{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web && npm run build:site",
  "outputDirectory": "dist",
  "functions": {
    "api/site.mjs": { "includeFiles": "site-server/**", "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/site?path=" },
    {
      "source": "/:path(projects(?:/.*)?|preview|sitemap\\.xml|robots\\.txt)",
      "destination": "/api/site?path=:path"
    },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/:path((?!projects(?:/|$)|preview$|sitemap\\.xml$|robots\\.txt$|site/|favicon\\.svg$|api/).+)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://izazjkpetaaztsajatni.supabase.co; font-src 'self' data:; connect-src 'self' https://izazjkpetaaztsajatni.supabase.co wss://izazjkpetaaztsajatni.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/site/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
