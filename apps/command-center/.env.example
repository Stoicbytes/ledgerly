# Public values only: they are embedded in the app bundle. Row Level Security protects the data.
# URL: Supabase → Project Settings → Data API → Project URL (nothing after .supabase.co).
# Key: Supabase → Project Settings → API Keys → publishable key (sb_publishable_...).
# Never put a secret or service-role key here. On Vercel, add both with these exact names
# for All Environments, then redeploy without the build cache (see README.md → Sign-in).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
