# Server-side settings for the public portfolio (Vercel → Project → Settings → Environment
# Variables). The page passes the URL, publishable key and handle to the browser, so only
# values that are public by design belong here: never a secret or service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The address you chose in the dashboard (Portfolio → Profile → Site address).
PORTFOLIO_HANDLE=your-handle
# Optional: the canonical address of this site (used in links for search engines and
# social previews). Without it the request's own address is used.
SITE_URL=https://your-portfolio.vercel.app
# Optional: where the Dashboard button goes (/dashboard on the same site, or an https address).
# Unset: no button. The dashboard's own project sets /dashboard automatically.
# DASHBOARD_URL=https://your-dashboard.vercel.app/dashboard
